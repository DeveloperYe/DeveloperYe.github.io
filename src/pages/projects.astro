---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: '图片压缩器',
    desc: '纯前端图片压缩工具：批量 / 直链 / ZIP 解压，可自定义目标体积上限，浏览器本地完成，不上传服务器。',
    repo: 'https://github.com/DeveloperYe/img500k',
    url: 'https://developerye.github.io/img500k/',
    tag: '前端工具',
  },
  {
    title: 'DeveloperYe.github.io',
    desc: '用 Astro 搭建、GitHub Actions 自动部署的纯静态个人主页，支持亮 / 暗主题切换。',
    repo: 'https://github.com/DeveloperYe/DeveloperYe.github.io',
    url: 'https://developerye.github.io',
    tag: 'Astro',
  },
  {
    title: 'handwriting-homework-pipeline',
    desc: '可复用 Agent Skills 套件：把「马原答题 → 生成 Word → 转手写稿 zip」串成一条流水线，含答题与手写生成两个子 skill。',
    repo: 'https://github.com/DeveloperYe/handwriting-homework-pipeline',
    url: 'https://github.com/DeveloperYe/handwriting-homework-pipeline',
    tag: 'Agent Skills',
  },
];
---

<BaseLayout title="作品集" description="DeveloperYe 的个人作品集">
  <section class="container page">
    <h1>作品集</h1>
    <p class="lede">一些我搭出来、真的能跑的东西。</p>

    <div class="grid">
      {
        projects.map((p) => (
          <article class="card">
            <span class="tag">{p.tag}</span>
            <h2>
              <a href={p.url} target="_blank" rel="noopener">{p.title}</a>
            </h2>
            <p>{p.desc}</p>
            <div class="links">
              <a href={p.repo} target="_blank" rel="noopener">仓库</a>
              <a href={p.url} target="_blank" rel="noopener">在线查看</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: 56px;
    padding-bottom: 72px;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 2rem;
  }

  .lede {
    color: var(--text-secondary);
    margin: 0 0 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    transition: all var(--transition);
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .tag {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-light);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 16px;
  }

  h2 {
    margin: 0 0 8px;
    font-size: 1.1rem;
  }

  h2 a {
    color: var(--text);
  }

  h2 a:hover {
    color: var(--accent);
  }

  .card p {
    margin: 0 0 20px;
    color: var(--text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  .links {
    display: flex;
    gap: 16px;
  }

  .links a {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>