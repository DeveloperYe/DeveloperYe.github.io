---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container article">
    <header class="head">
      <h1>{post.data.title}</h1>
      <p class="meta">
        {fmt(post.data.pubDate)}
        {post.data.tags.length > 0 && (
          <span class="tags">
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
          </span>
        )}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: 56px;
    padding-bottom: 80px;
    max-width: 720px;
  }

  .head {
    margin-bottom: 36px;
  }

  h1 {
    font-size: 2rem;
    margin: 0 0 12px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .tags {
    display: inline-flex;
    gap: 8px;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-light);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .prose {
    color: var(--text);
    line-height: 1.9;
    font-size: 1rem;
  }

  .prose h2 {
    font-size: 1.4rem;
    margin: 32px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .prose h3 {
    font-size: 1.15rem;
    margin: 24px 0 10px;
  }

  .prose p {
    margin: 0 0 16px;
  }

  .prose a {
    color: var(--accent);
  }

  .prose blockquote {
    margin: 20px 0;
    padding: 4px 0 4px 16px;
    border-left: 3px solid var(--accent);
    color: var(--text-secondary);
    font-style: italic;
  }

  .prose ul,
  .prose ol {
    margin: 0 0 16px;
    padding-left: 24px;
  }

  .prose li {
    margin: 6px 0;
  }

  .prose code {
    background: var(--bg-tertiary);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 0.9em;
  }

  .prose pre {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    overflow-x: auto;
    margin: 0 0 16px;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }
</style>