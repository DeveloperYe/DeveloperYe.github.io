---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = '一个使用 Astro 构建的个人网站',
  image = '/og.jpg',
} = Astro.props;

const siteName = 'DeveloperYe';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

// SEO：规范化地址、分享图绝对链接、结构化数据
const siteUrl = Astro.site ?? new URL('https://developerye.github.io');
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl).href;

const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl.href,
  description,
  author: {
    '@type': 'Person',
    name: 'DeveloperYe',
    url: 'https://github.com/DeveloperYe',
  },
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 主题初始化（防止闪烁） -->
    <script is:inline>
      const theme = (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') return saved;
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
    <script type="application/ld+json" set:html={ld}></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
